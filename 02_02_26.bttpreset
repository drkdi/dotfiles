        {
          "BTTLastUpdatedAt" : 1764883811.3828869,
          "BTTTriggerClass" : "BTTTriggerTypeKeyboardShortcut",
          "BTTUUID" : "CABD104B-32D8-4E2C-84FD-DC43489B8F9C",
          "BTTPredefinedActionType" : 195,
          "BTTPredefinedActionName" : "Run Apple Script (async in background)",
          "BTTInlineAppleScript" : "\ractivate application \"SystemUIServer\"\rtell application \"System Events\"\r\ttell process \"SystemUIServer\"\r\t\t-- Working CONNECT Script.  Goes through the following:\r\t\t-- Clicks on Bluetooth Menu (OSX Top Menu Bar)\r\t\t--    => Clicks on dairp Item\r\t\t--      => Clicks on Connect Item\r\t\tset btMenu to (menu bar item 1 of menu bar 1 whose description contains \"bluetooth\")\r\t\ttell btMenu\r\t\t\tclick\r\t\t\ttell (menu item \"dairp\" of menu 1)\r\t\t\t\tclick\r\t\t\t\tif exists menu item \"Connect\" of menu 1 then\r\t\t\t\t\tclick menu item \"Connect\" of menu 1\r\t\t\t\t\treturn \"Connecting...\"\r\t\t\t\telse\r\t\t\t\t\tclick btMenu -- Close main BT drop down if Connect wasn't present\r\t\t\t\t\treturn \"Connect menu was not found, are you already connected?\"\r\t\t\t\tend if\r\t\t\tend tell\r\t\tend tell\r\tend tell\rend tell",
          "BTTAdditionalConfiguration" : "262144",
          "BTTShortcutKeyboardType" : 0,
          "BTTTriggerOnDown" : 1,
          "BTTEnabled" : 0,
          "BTTShortcutKeyCode" : 0,
