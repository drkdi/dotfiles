          "BTTPredefinedActionType" : 172,
          "BTTPredefinedActionName" : "Run Apple Script (blocking)",
          "BTTInlineAppleScript" : "set device to do shell script \"networksetup -listallhardwareports | awk '$3==\\\"Wi-Fi\\\" {getline;print}' | awk '{print $2}'\"\r\rset power to do shell script \"networksetup -getairportpower \" & device & \" | awk '{print $4}'\"\r\rif power is equal to \"on\" then\r\tset power to \"off\"\relse\r\tset power to \"on\"\rend if\r\rdo shell script (\"networksetup -setairportpower \" & device & \" \" & power)\r",
