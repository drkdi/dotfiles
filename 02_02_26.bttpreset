          "BTTUUID" : "FFD84FC0-20CA-477D-A47E-D02D7CB7519A",
          "BTTPredefinedActionType" : 172,
          "BTTPredefinedActionName" : "Run Apple Script (blocking)",
          "BTTInlineAppleScript" : "tell application \"System Events\"\r\t\r\ttell process \"System Preferences\"\r\t\tactivate\r\tend tell\r\t\r\ttell application \"System Preferences\"\r\t\tset current pane to pane \"com.apple.preferences.Bluetooth\"\r\tend tell\r\t\r\ttell process \"System Preferences\"\r\t\t\r\t\tset statName to name of button 3 of window 1 as string\r\t\tset failSafe to 0\r\t\t\r\t\trepeat until statName is not name of button 3 of window 1 as string ¬\r\t\t\tor failSafe is 10\r\t\t\tclick button 3 of window 1\r\t\t\tset failSafe to failSafe + 1\r\t\t\tdelay 0.1\r\t\tend repeat\r\t\t\r\tend tell\r\t\r\ttell application \"System Preferences\"\r\t\tquit\r\tend tell\r\t\rend tell\r",
