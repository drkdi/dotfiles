        {
          "BTTLastUpdatedAt" : 1764883811.3829079,
          "BTTTriggerClass" : "BTTTriggerTypeKeyboardShortcut",
          "BTTUUID" : "8241E2F5-3566-4E34-86F2-05B84A89C90F",
          "BTTPredefinedActionType" : 172,
          "BTTPredefinedActionName" : "Run Apple Script (blocking)",
          "BTTInlineAppleScript" : "set device to do shell script \"networksetup -listallhardwareports | awk '$3==\\\"Wi-Fi\\\" {getline;print}' | awk '{print $2}'\"\r\rset power to do shell script \"networksetup -getairportpower \" & device & \" | awk '{print $4}'\"\r\rif power is equal to \"on\" then\r\tset power to \"off\"\relse\r\tset power to \"on\"\rend if\r\rdo shell script (\"networksetup -setairportpower \" & device & \" \" & power)\rtell application \"System Events\"\r\t\r\ttell process \"System Preferences\"\r\t\tactivate\r\tend tell\r\t\r\ttell application \"System Preferences\"\r\t\tset current pane to pane \"com.apple.preferences.Bluetooth\"\r\tend tell\r\t\r\ttell process \"System Preferences\"\r\t\t\r\t\tset statName to name of button 3 of window 1 as string\r\t\tset failSafe to 0\r\t\t\r\t\trepeat until statName is not name of button 3 of window 1 as string ¬\r\t\t\tor failSafe is 10\r\t\t\tclick button 3 of window 1\r\t\t\tset failSafe to failSafe + 1\r\t\t\tdelay 0.1\r\t\tend repeat\r\t\t\r\tend tell\r\t\r\ttell application \"System Preferences\"\r\t\tquit\r\tend tell\r\t\rend tell\r",
          "BTTAdditionalConfiguration" : "1048576",
          "BTTShortcutKeyboardType" : 0,
