    cat << 'EOF'
    ____        __  _____ __         
   / __ \____  / /_/ __(_) /__  _____
  / / / / __ \/ __/ /_/ / / _ \/ ___/
 / /_/ / /_/ / /_/ __/ / /  __(__  ) 
/_____/\____/\__/_/ /_/_/\___/____/  
                                     
EOF
    echo -e "${RESET}${DIM}v${SCRIPT_VERSION} - Dotfiles Manager${RESET}"
    echo
}

show_menu() {
    local options=(
        "1) Backup dotfiles to zip"
        "2) Restore dotfiles from zip"
        "3) Setup new machine"
        "4) Sync to git repository"
        "5) Show diff (local vs backup)"
        "6) List managed files"
        "7) Edit configuration"
        "8) Exit"
    )
    
    echo -e "${BOLD}What would you like to do?${RESET}"
    echo
    
    # Use fzf if available for better UX
    if command_exists fzf; then
        local choice
        choice=$(printf '%s\n' "${options[@]}" | fzf --height=12 --reverse --prompt="Select: " --pointer="▶" --color="pointer:cyan,prompt:blue" 2>/dev/null) || choice=""
        echo "$choice"
    else
        for opt in "${options[@]}"; do
            echo "  $opt"
        done
        echo
        read -rp "${BLUE}Enter choice [1-8]:${RESET} " num
        if [[ "$num" =~ ^[1-8]$ ]]; then
            echo "${options[$((num-1))]}"
        fi
    fi
}

# ============================================================================
# Backup Functions
# ============================================================================

backup_dotfiles() {
    local include_personal="${1:-false}"
    local output_file="$BACKUP_FILE"
    
    if [[ "$include_personal" == "true" ]]; then
        output_file="$BACKUP_PERSONAL"
    fi
    
    header "Backing up dotfiles"
    
    # Cleanup
    step "Cleaning up temporary directory..."
    if $DRY_RUN; then
        step "[dry-run] Would remove and recreate $TMP_DIR"
    else
        rm -rf "$TMP_DIR"
        mkdir -p "$TMP_DIR"
    fi
    
    # Copy dotfiles
    info "Copying dotfiles..."
    for pair in "${DOTFILES[@]}"; do
        local src dest
        src=$(get_src "$pair")
        dest="$TMP_DIR/$(get_dest "$pair")"
        safe_copy "$src" "$dest" || true
    done
    
    # Copy directories
    info "Copying directories..."
    for pair in "${DOTFILE_DIRS[@]}"; do
        local src dest
        src=$(get_src "$pair")
        dest="$TMP_DIR/$(get_dest "$pair")"
        safe_copy "$src" "$dest" || true
    done
    
    # Clone cvim gist
    if ! $DRY_RUN; then
        info "Cloning cvim configuration..."
        if [[ -d "$TMP_DIR/cvim" ]]; then
            rm -rf "$TMP_DIR/cvim"
        fi
        mkdir -p "$TMP_DIR/cvim"
        if git clone --quiet https://gist.github.com/drkdi/4e03d5828cce47d42d54f9c5507479d1 "$TMP_DIR/cvim" 2>/dev/null; then
            rm -rf "$TMP_DIR/cvim/.git"
            success "Cloned cvim configuration"
        else
            warn "Failed to clone cvim gist"
        fi
    fi
    
    # Handle BTT presets
    if ! $DRY_RUN; then
        info "Processing BetterTouchTool presets..."
        local latest_btt=""
        local preset
        for preset in "$HOME"/Downloads/*.bttpreset; do
            [[ -e "$preset" ]] || continue
            if [[ -z "$latest_btt" || "$preset" -nt "$latest_btt" ]]; then
                latest_btt="$preset"
            fi
        done
        if [[ -n "$latest_btt" ]]; then
            cp "$latest_btt" "$TMP_DIR/$(date +"%m-%d-%y").bttpreset"
            success "Processed BTT presets"
        else
            info "No BTT preset found in Downloads"
        fi
    fi
    
    # Personal files
    if [[ "$include_personal" == "true" ]]; then
        info "Including personal files..."
        for pair in "${PERSONAL_FILES[@]}"; do
            local src dest
            src=$(get_src "$pair")
            dest="$TMP_DIR/$(get_dest "$pair")"
            safe_copy "$src" "$dest" || true
        done
        for pair in "${PERSONAL_DIRS[@]}"; do
            local src dest
            src=$(get_src "$pair")
            dest="$TMP_DIR/$(get_dest "$pair")"
            safe_copy "$src" "$dest" || true
        done
    fi
    
    # Create zip
    if ! $DRY_RUN; then
        info "Creating zip archive..."
        (cd "$TMP_DIR" && zip -rq "$HOME/tmp-files.zip" .)
        mv "$HOME/tmp-files.zip" "$output_file"
        rm -rf "$TMP_DIR"
        success "Created: $output_file"
    else
        step "[dry-run] Would create: $output_file"
    fi
    
    echo
    success "Backup complete!"
}

# ============================================================================
# Restore Functions
# ============================================================================

restore_from_repo() {
    header "Restoring dotfiles from repository"

    if [[ ! -d "$DOTFILES_REPO" ]]; then
        error "Dotfiles repository not found: $DOTFILES_REPO"
        return 1
    fi

    local pair src dest_rel repo_src
    for pair in "${DOTFILES[@]}" "${DOTFILE_DIRS[@]}" "${REPO_ONLY_FILES[@]}"; do
        src=$(get_src "$pair")
        dest_rel=$(get_dest "$pair")
        repo_src="$DOTFILES_REPO/$dest_rel"
        safe_copy "$repo_src" "$src" || true
    done

    success "Restored managed files from repository"
}

restore_repo_only_files() {
    local pair src dest_rel repo_src
    for pair in "${REPO_ONLY_FILES[@]}"; do
        src=$(get_src "$pair")
        dest_rel=$(get_dest "$pair")
        repo_src="$DOTFILES_REPO/$dest_rel"
        safe_copy "$repo_src" "$src" || true
    done
}

restore_dotfiles() {
    local use_personal="${1:-false}"
    local force="${2:-false}"
    local source_file="$BACKUP_FILE"
    
    if [[ "$use_personal" == "true" ]]; then
        source_file="$BACKUP_PERSONAL"
    fi
    
    header "Restoring dotfiles"
    
    if [[ ! -f "$source_file" ]]; then
        error "Backup file not found: $source_file"
        return 1
    fi
    
    if [[ "$force" == "true" ]] || $FORCE; then
        info "Force restoring from $source_file..."
        if ! $DRY_RUN; then
            unzip -o "$source_file" -d "$HOME"
            success "Restored all dotfiles"
        else
            step "[dry-run] Would extract: $source_file → $HOME"
        fi
    else
        # Interactive diff mode
        info "Extracting to temporary location for comparison..."
        local temp_extract="$HOME/Downloads/tmp-files"
        
        if ! $DRY_RUN; then
            rm -rf "$temp_extract"
            mkdir -p "$temp_extract"
            unzip -o "$source_file" -d "$temp_extract"
            
            info "Comparing files (use 'do' to accept, 'dp' to reject in vimdiff)..."
            
            while IFS= read -r line; do
                local file1 file2
                file1=$(echo "$line" | sed 's/^Files //;s/ and .*$//')
                file2=$(echo "$line" | sed 's/^.* and //;s/ differ$//')
                
                # Skip system files
                if [[ "$file1" == *"DS_Store"* ]] || [[ "$file1" == *"cvim"* ]]; then
                    continue
                fi
                
                echo
                info "Difference found: $(basename "$file1")"
                if confirm "Review changes?"; then
                    vimdiff "$file1" "$file2"
                fi
            done < <(diff -rq "$HOME" "$temp_extract" 2>/dev/null | grep 'differ$' || true)
            
            rm -rf "$temp_extract"
        else
            step "[dry-run] Would compare and interactively merge files"
        fi
    fi
    
    echo
    success "Restore complete!"
}

# ============================================================================
# Setup Functions
# ============================================================================

setup_new_machine() {
    header "Setting up new machine"
    
    if ! is_macos; then
        warn "Some features are macOS-specific"
    fi
    
    # Show what will be done
    info "This will:"
    echo "  1. Install Homebrew (if not installed)"
    echo "  2. Install essential packages and apps via Homebrew"
    echo "  3. Configure saved macOS keyboard, trackpad, Dock, and Finder settings"
    echo "  4. Restore dotfiles from the repository or backup"
    echo "  5. Install fonts and the BetterTouchTool preset"
    echo "  6. Bootstrap Neovim and tmux plugins"
    echo "  7. Configure Git identity and performance"
    echo
    
    if ! confirm "Proceed with setup?" "y"; then
        info "Setup cancelled"
        return 0
    fi
    
    # 1. Homebrew
    header "Installing Homebrew"
    if command_exists brew; then
        success "Homebrew already installed"
    else
        if $DRY_RUN; then
            step "[dry-run] Would install Homebrew"
        else
            info "Installing Homebrew..."
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            
            # Add to path for Apple Silicon
            if [[ -f "/opt/homebrew/bin/brew" ]]; then
                eval "$(/opt/homebrew/bin/brew shellenv)"
            fi
            success "Homebrew installed"
        fi
    fi
    
    # 2. Brew packages and casks
    header "Installing packages"
    if $DRY_RUN; then
        step "[dry-run] Would install: ${BREW_ESSENTIAL[*]}"
        step "[dry-run] Would install casks: ${BREW_CASKS[*]}"
    else
        local brew_file=""
        if [[ -f "$HOME/.brew" ]]; then
            brew_file="$HOME/.brew"
        elif [[ -f "$DOTFILES_REPO/.brew" ]]; then
            brew_file="$DOTFILES_REPO/.brew"
        fi

        if [[ -n "$brew_file" ]]; then
            info "Installing packages from $brew_file..."
            local package_failures=0
            while IFS= read -r line || [[ -n "$line" ]]; do
                local pkg="${line%%#*}"
                pkg="${pkg#"${pkg%%[![:space:]]*}"}"
                pkg="${pkg%"${pkg##*[![:space:]]}"}"
                [[ -z "$pkg" ]] && continue
                if brew list "$pkg" </dev/null &>/dev/null; then
                    step "$pkg (already installed)"
                else
                    step "Installing $pkg..."
                    if ! brew install "$pkg" </dev/null 2>/dev/null; then
                        warn "Failed to install $pkg"
                        ((package_failures += 1))
                    fi
                fi
            done < "$brew_file"
            if (( package_failures > 0 )); then
                warn "$package_failures package(s) failed to install"
            fi
        else
            info "Installing essential packages..."
            for pkg in "${BREW_ESSENTIAL[@]}"; do
                if brew list "$pkg" &>/dev/null; then
                    step "$pkg (already installed)"
                else
                    step "Installing $pkg..."
                    brew install "$pkg" 2>/dev/null || warn "Failed to install $pkg"
                fi
            done
        fi

        for cask in "${BREW_CASKS[@]}"; do
            if brew list --cask "$cask" &>/dev/null; then
                step "$cask (already installed)"
            else
                step "Installing cask $cask..."
                brew install --cask "$cask" 2>/dev/null || warn "Failed to install cask $cask"
            fi
        done
        success "Packages installed"
    fi
    
    # 3. Saved macOS preferences
    configure_macos_defaults
    
    # 4. Restore dotfiles before bootstrapping dependent tools
    header "Restoring dotfiles"
    if [[ -f "$BACKUP_PERSONAL" ]]; then
        restore_dotfiles true true
        restore_repo_only_files
    elif [[ -f "$BACKUP_FILE" ]]; then
        restore_dotfiles false true
        restore_repo_only_files
    else
        restore_from_repo
    fi

    # 5. Fonts
    header "Installing fonts"
    if ls "$HOME"/*.otf 1> /dev/null 2>&1 || ls "$HOME"/*.ttf 1> /dev/null 2>&1; then
        if $DRY_RUN; then
            step "[dry-run] Would install fonts"
        else
            for font in "$HOME"/*.otf "$HOME"/*.ttf; do
                [[ -e "$font" ]] || continue
                open "$font"
                step "Installing: $(basename "$font")"
            done
            success "Fonts opened for installation"
        fi
    else
        info "No font files found in home directory"
    fi
    
    # 5. BetterTouchTool
    header "Installing BetterTouchTool preset"
    local btt_preset=""
    local candidate
    for candidate in "$HOME"/*.bttpreset "$DOTFILES_REPO"/*.bttpreset; do
        [[ -e "$candidate" ]] || continue
        if [[ -z "$btt_preset" || "$candidate" -nt "$btt_preset" ]]; then
            btt_preset="$candidate"
        fi
    done
    if [[ -n "$btt_preset" ]]; then
        if $DRY_RUN; then
            step "[dry-run] Would open BTT preset: $btt_preset"
        else
            open "$btt_preset"
            success "BTT preset opened"
        fi
    else
        info "No BTT preset found"
    fi

    # 6. Bootstrap Neovim plugins
    header "Bootstrapping Neovim"
    if command_exists nvim; then
        if $DRY_RUN; then
            step "[dry-run] Would install Neovim plugins via lazy.nvim"
        else
            info "Installing Neovim plugins (lazy.nvim sync)..."
            nvim --headless "+Lazy! sync" +qa 2>/dev/null && \
                success "Neovim plugins installed" || \
                warn "Neovim plugin install had issues (run :Lazy sync manually)"
        fi
    else
        warn "Neovim not found — skipping plugin bootstrap"
    fi

    header "Bootstrapping tmux plugins"
    if [[ -d "$HOME/.tmux/plugins/tpm" ]]; then
        success "tmux plugin manager already installed"
    elif $DRY_RUN; then
        step "[dry-run] Would clone tmux plugin manager to $HOME/.tmux/plugins/tpm"
    else
        git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm" && \
            success "tmux plugin manager installed" || \
            warn "tmux plugin manager installation failed"
    fi
    
    # 7. Git identity (not stored in repo)
    header "Configuring Git identity"
    if $DRY_RUN; then
        step "[dry-run] Would prompt for git user.name and user.email"
    else
        local current_name
        current_name=$(git config --global user.name 2>/dev/null || true)
        local current_email
        current_email=$(git config --global user.email 2>/dev/null || true)

        if [[ -n "$current_name" && -n "$current_email" ]]; then
            info "Git identity already set: $current_name <$current_email>"
        else
            info "No global Git identity found — setting one now."
            if [[ -z "$current_name" ]]; then
                read -rp "  Enter your name for git commits: " current_name
                git config --global user.name "$current_name"
            fi
            if [[ -z "$current_email" ]]; then
                read -rp "  Enter your email for git commits: " current_email
                git config --global user.email "$current_email"
            fi
            success "Git identity set: $current_name <$current_email>"
        fi
    fi

    # 7. Git performance (fsmonitor + untracked cache)
    header "Optimizing Git performance"
    if $DRY_RUN; then
        step "[dry-run] Would enable core.fsmonitor and core.untrackedcache globally"
    else
        info "Enabling filesystem monitor daemon (avoids stat-ing every file)..."
        git config --global core.fsmonitor true
        success "core.fsmonitor enabled"
        
        info "Enabling untracked file cache (avoids re-scanning directories)..."
        git config --global core.untrackedcache true
        success "core.untrackedcache enabled"
        
        info "These speed up git status/diff/add in large repos (e.g. 39K+ files: 1.7s → 0.13s)"
    fi
    
    echo
    echo -e "${GREEN}${BOLD}━━━ Setup Complete! ━━━${RESET}"
    echo
    info "Please restart your terminal or run: source ~/.zshrc"
}

# ============================================================================
# Sync Functions
# ============================================================================

sync_to_git() {
    header "Syncing to git repository"

    local dotfiles_dir="$DOTFILES_REPO"
    
    if [[ ! -d "$dotfiles_dir" ]]; then
        error "Dotfiles repository not found"
        info "Expected at: $dotfiles_dir"
        return 1
    fi

    local current_branch
    current_branch=$(git -C "$dotfiles_dir" branch --show-current 2>/dev/null || true)
    if [[ "$current_branch" != "main" ]]; then
        error "Sync must run from the main branch (current: ${current_branch:-detached HEAD})"
        info "Switch to main and update it before syncing"
        return 1
    fi

    if [[ -n "$(git -C "$dotfiles_dir" status --porcelain)" ]]; then
        error "Dotfiles repository has uncommitted changes"
        info "Commit, stash, or discard them before syncing"
        return 1
    fi

    if ! git -C "$dotfiles_dir" fetch origin main; then
        error "Could not fetch origin/main"
        return 1
    fi
    if ! git -C "$dotfiles_dir" merge-base --is-ancestor origin/main main; then
        error "Local main is behind or diverged from origin/main"
        info "Update main before syncing"
        return 1
    fi
    
    info "Using repository: $dotfiles_dir"
    
    # First backup
    backup_dotfiles false
    
    if $DRY_RUN; then
        step "[dry-run] Would extract backup to $dotfiles_dir"
        step "[dry-run] Would commit and push changes"
    else
        # Clean and extract
        rm -f "$dotfiles_dir"/*.bttpreset
        unzip -o "$BACKUP_FILE" -d "$dotfiles_dir"
        
        # Git operations
        cd "$dotfiles_dir"
        local pair dest_rel
        for pair in "${DOTFILES[@]}" "${DOTFILE_DIRS[@]}" "${REPO_ONLY_FILES[@]}"; do
            dest_rel=$(get_dest "$pair")
            git add -- "$dest_rel"
        done
        git add -- dotfiles-manager .gitignore cvim
        git add -A -- ':(glob)*.bttpreset'
        
        if git diff --cached --quiet; then
            info "No changes to commit"
        else
            local commit_msg="Update dotfiles $(date +'%Y-%m-%d %H:%M')"
            git commit -m "$commit_msg"
            
            if confirm "Push to remote?"; then
                git push origin main
                success "Pushed to remote"
                
                # Open in browser
                if is_macos && command_exists open; then
                    open "https://github.com/drkdi/dotfiles/commits/main"
                fi
            fi
        fi
    fi
    
    echo
    success "Sync complete!"
}

# ============================================================================
# Diff Functions
# ============================================================================

show_diff() {
    header "Comparing local files with backup"
    
    if [[ ! -f "$BACKUP_FILE" ]]; then
        error "Backup file not found: $BACKUP_FILE"
        return 1
    fi
    
    local temp_dir
    temp_dir=$(mktemp -d)
    unzip -q "$BACKUP_FILE" -d "$temp_dir"
    
    local has_diff=false
    
    for pair in "${DOTFILES[@]}"; do
        local src dest_rel backup_file
        src=$(get_src "$pair")
        dest_rel=$(get_dest "$pair")
        backup_file="$temp_dir/$dest_rel"
        
        if [[ ! -f "$src" ]]; then
            warn "Local missing: $src"
            has_diff=true
        elif [[ ! -f "$backup_file" ]]; then
            warn "Backup missing: $dest_rel"
            has_diff=true
        elif ! diff -q "$src" "$backup_file" &>/dev/null; then
            echo -e "${YELLOW}Modified:${RESET} $(basename "$src")"
            if confirm "  Show diff?"; then
                diff --color=auto "$src" "$backup_file" || true
            fi
            has_diff=true
        else
            echo -e "${GREEN}Unchanged:${RESET} $(basename "$src")"
        fi
    done
    
    rm -rf "$temp_dir"
    
    if ! $has_diff; then
        success "All files are in sync!"
    fi
}

# ============================================================================
# List Functions
# ============================================================================

list_managed() {
    header "Managed Files"
    
    echo -e "${BOLD}Dotfiles:${RESET}"
    for pair in "${DOTFILES[@]}"; do
        local src
        src=$(get_src "$pair")
        if [[ -f "$src" ]]; then
            echo -e "  ${GREEN}✓${RESET} $src"
        else
            echo -e "  ${RED}✗${RESET} $src ${DIM}(not found)${RESET}"
        fi
    done
    
    echo
    echo -e "${BOLD}Directories:${RESET}"
    for pair in "${DOTFILE_DIRS[@]}"; do
        local src
        src=$(get_src "$pair")
        if [[ -e "$src" ]]; then
            echo -e "  ${GREEN}✓${RESET} $src"
        else
            echo -e "  ${RED}✗${RESET} $src ${DIM}(not found)${RESET}"
        fi
    done

    echo
    echo -e "${BOLD}Repository-only templates:${RESET}"
    for pair in "${REPO_ONLY_FILES[@]}"; do
        local repo_file
        repo_file="$DOTFILES_REPO/$(get_dest "$pair")"
        if [[ -f "$repo_file" ]]; then
            echo -e "  ${GREEN}✓${RESET} $repo_file"
        else
            echo -e "  ${RED}✗${RESET} $repo_file ${DIM}(not found)${RESET}"
        fi
    done

    echo
    echo -e "${BOLD}Personal files (--personal):${RESET}"
    for pair in "${PERSONAL_FILES[@]}"; do
        local src
        src=$(get_src "$pair")
        if [[ -f "$src" ]]; then
            echo -e "  ${GREEN}✓${RESET} $src"
        else
            echo -e "  ${DIM}○${RESET} $src ${DIM}(not found)${RESET}"
        fi
    done
}

# ============================================================================
# Help
# ============================================================================

show_help() {
    cat << EOF
${BOLD}$SCRIPT_NAME${RESET} v$SCRIPT_VERSION - Dotfiles backup, restore & setup tool

${BOLD}USAGE:${RESET}
    $SCRIPT_NAME [command] [options]

${BOLD}COMMANDS:${RESET}
    (none)          Interactive mode with menu
    backup          Create backup zip of dotfiles
    restore         Restore dotfiles from backup  
    setup           First-time machine setup
    sync            Sync to git repository
    diff            Show differences between local and backup
    list            List all managed files

${BOLD}OPTIONS:${RESET}
    --personal      Include personal/private files
    --force         Overwrite without prompting
    --dry-run       Show what would be done without doing it
    --help, -h      Show this help message
    --version, -v   Show version

${BOLD}EXAMPLES:${RESET}
    $SCRIPT_NAME                    # Interactive mode
    $SCRIPT_NAME backup             # Backup dotfiles
    $SCRIPT_NAME backup --personal  # Include personal files
    $SCRIPT_NAME restore --force    # Restore without prompts
    $SCRIPT_NAME setup              # Setup new machine
    $SCRIPT_NAME sync               # Sync to git repo

${BOLD}NEW MAC:${RESET}
    git clone https://github.com/drkdi/dotfiles.git
    cd dotfiles
    ./dotfiles-manager setup

${BOLD}FILES:${RESET}
    Backup:   $BACKUP_FILE
    Personal: $BACKUP_PERSONAL
    Log:      $LOG_FILE

EOF
}

# ============================================================================
# Main
# ============================================================================

main() {
    local command=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            backup|restore|setup|sync|diff|list)
                command="$1"
                ;;
            --personal|-p)
                PERSONAL=true
                ;;
            --force|-f)
                FORCE=true
                ;;
            --dry-run|-n)
                DRY_RUN=true
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            --version|-v)
                echo "$SCRIPT_NAME v$SCRIPT_VERSION"
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
        shift
    done
    
    # Show dry-run notice
    if $DRY_RUN; then
        warn "DRY RUN MODE - No changes will be made"
        echo
    fi
    
    # Execute command or show menu
    if [[ -n "$command" ]]; then
        case "$command" in
            backup)
                backup_dotfiles "$PERSONAL"
                ;;
            restore)
                restore_dotfiles "$PERSONAL" "$FORCE"
                ;;
            setup)
                setup_new_machine
                ;;
            sync)
                sync_to_git
                ;;
            diff)
                show_diff
                ;;
            list)
                list_managed
                ;;
        esac
    else
        # Interactive mode
        show_banner
        
        while true; do
            choice=$(show_menu)
            
            case "$choice" in
                *"Backup"*)
                    if confirm "Include personal files?"; then
                        backup_dotfiles true
                    else
                        backup_dotfiles false
                    fi
                    ;;
                *"Restore"*)
                    if confirm "Use personal backup?"; then
                        restore_dotfiles true
                    else
                        restore_dotfiles false
                    fi
                    ;;
                *"Setup"*)
                    setup_new_machine
                    ;;
                *"Sync"*)
                    sync_to_git
                    ;;
                *"diff"*)
                    show_diff
                    ;;
                *"List"*)
                    list_managed
                    ;;
                *"Edit"*)
                    ${EDITOR:-vim} "${BASH_SOURCE[0]}"
                    ;;
                *"Exit"*|"")
                    info "Goodbye!"
                    exit 0
                    ;;
            esac
            
            echo
            if ! confirm "Do something else?"; then
                break
            fi
        done
    fi
}

if [[ "${DOTFILES_MANAGER_SOURCE_ONLY:-false}" != "true" ]]; then
    main "$@"
fi
