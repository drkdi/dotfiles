# ============================================================================
# FILES TO BACKUP
# Format: "source:destination" pairs
# ============================================================================

# Core dotfiles (always backed up)
DOTFILES=(
    # Shell
    "$HOME/.zshrc:.zshrc"
    "$HOME/display-mode:display-mode"
    
    # Editor (Vim fallback — regular Vim still sources this)
    "$HOME/.vimrc:.vimrc"
    
    # Terminal multiplexer
    "$HOME/.tmux.conf:.tmux.conf"
    
    # Package list
    "$HOME/.brew:.brew"
)

# Safe templates restored from the repository but never copied back during sync.
# This prevents machine-local identity and credential settings from entering Git.
REPO_ONLY_FILES=(
    "$HOME/.gitconfig:.gitconfig"
)

# Nested config files
DOTFILE_DIRS=(
    # Neovim — primary editor config (native Lua, lazy.nvim + native LSP)
    "$HOME/.config/nvim/init.lua:.config/nvim/init.lua"
    
    # Vim fallback — only used when running regular Vim (not Neovim)
    "$HOME/.vim/plugins.vim:.vim/plugins.vim"
    "$HOME/.vim/coc-plugin.vim:.vim/coc-plugin.vim"
    "$HOME/.vim/coc-settings.json:.vim/coc-settings.json"
    
    # Terminal emulator (standard location)
    "$HOME/.config/alacritty/alacritty.toml:.config/alacritty/alacritty.toml"
    
    # Global gitignore
    "$HOME/.gitignore_global:.gitignore_global"
)

# Personal files (--personal flag, not synced to public git)
PERSONAL_FILES=(
    # Licensed fonts are included only in the private backup archive.
    "$HOME/Library/Fonts/DankMono-Italic-Nerd-Font-Mono.otf:DankMono-Italic-Nerd-Font-Mono.otf"
    "$HOME/Library/Fonts/DankMono-Regular-Nerd-Font-Mono.otf:DankMono-Regular-Nerd-Font-Mono.otf"
    "$HOME/Library/Fonts/DankMono-Italic.otf:DankMono-Italic.otf"
    "$HOME/Library/Fonts/DankMono-Regular.otf:DankMono-Regular.otf"
)

PERSONAL_DIRS=(
    # Tmuxinator workspace configs (if you use them)
    "$HOME/.config/tmuxinator:.config/tmuxinator"

    # Reviewed private shell helpers; excludes ~/.zshrc.local and secrets.
    "$HOME/.config/dotfiles-private:.config/dotfiles-private"

    # Personal Codex skills may contain company-specific workflows. Keep them
    # in the private transfer archive and never stage them in the public repo.
    "$HOME/.codex/skills:.codex/skills"
)

# Brew packages to install (fallback if ~/.brew doesn't exist)
