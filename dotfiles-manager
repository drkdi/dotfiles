# ============================================================================
# Colors & Formatting
# ============================================================================

if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly BLUE='\033[0;34m'
    readonly MAGENTA='\033[0;35m'
    readonly CYAN='\033[0;36m'
    readonly BOLD='\033[1m'
    readonly DIM='\033[2m'
    readonly RESET='\033[0m'
else
    readonly RED='' GREEN='' YELLOW='' BLUE='' MAGENTA='' CYAN='' BOLD='' DIM='' RESET=''
fi

# ============================================================================
# Logging & Output
# ============================================================================

log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $message" >> "$LOG_FILE"
}

info() {
    echo -e "${BLUE}ℹ${RESET} $*"
    log "INFO" "$*"
}

success() {
    echo -e "${GREEN}✓${RESET} $*"
    log "SUCCESS" "$*"
}

warn() {
    echo -e "${YELLOW}⚠${RESET} $*"
    log "WARN" "$*"
}

error() {
    echo -e "${RED}✗${RESET} $*" >&2
    log "ERROR" "$*"
}

header() {
    echo
    echo -e "${BOLD}${CYAN}━━━ $* ━━━${RESET}"
    echo
}

step() {
    echo -e "  ${DIM}→${RESET} $*"
}

# ============================================================================
# Utility Functions
# ============================================================================

DRY_RUN=false
FORCE=false
PERSONAL=false

is_macos() {
    [[ "$(uname)" == "Darwin" ]]
}

command_exists() {
    command -v "$1" &> /dev/null
}

ensure_dir() {
    local dir="$1"
    if [[ ! -d "$dir" ]]; then
        if $DRY_RUN; then
            step "[dry-run] Would create directory: $dir"
        else
            mkdir -p "$dir"
        fi
    fi
}

# Parse "source:dest" pair
get_src() {
    echo "${1%%:*}"
}

get_dest() {
    echo "${1#*:}"
}

safe_copy() {
    local src="$1"
    local dest="$2"
    
    if [[ ! -e "$src" ]]; then
        warn "Source not found: $src"
        return 1
    fi
    
    if $DRY_RUN; then
        step "[dry-run] Would copy: $src → $dest"
        return 0
    fi
    
    ensure_dir "$(dirname "$dest")"
    
    if [[ -d "$src" ]]; then
        cp -R "$src" "$dest"
    else
        cp "$src" "$dest"
    fi
    success "Copied: $(basename "$src")"
}

configure_macos_defaults() {
    if ! is_macos; then
        warn "Skipping macOS preferences on non-macOS system"
        return 0
    fi

    header "Configuring macOS preferences"
    local setting domain key type value
    for setting in "${MACOS_DEFAULTS[@]}"; do
        IFS='|' read -r domain key type value <<< "$setting"
        if $DRY_RUN; then
            step "[dry-run] Would set $domain $key ($type) to $value"
        else
            defaults write "$domain" "$key" "-$type" "$value"
        fi
    done

    if $DRY_RUN; then
        step "[dry-run] Would restart Dock and Finder"
    else
        killall Dock 2>/dev/null || true
        killall Finder 2>/dev/null || true
        success "macOS preferences applied (some trackpad changes may require logout)"
    fi
}

confirm() {
    local prompt="$1"
    local default="${2:-n}"
    
    if $FORCE; then
        return 0
    fi
    
    local yn
    if [[ "$default" == "y" ]]; then
        read -rp "$prompt [Y/n] " yn
        yn="${yn:-y}"
    else
        read -rp "$prompt [y/N] " yn
        yn="${yn:-n}"
    fi
    
    [[ "$yn" =~ ^[Yy] ]]
}

