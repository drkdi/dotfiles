# ============================================================================

# Homebrew packages for dotfiles setup

# Install all: for pkg in $(cat ~/.brew); do brew install "$pkg"; done

# ============================================================================

# --- Shell & Prompt ---

zsh
zsh-syntax-highlighting
zsh-autosuggestions
pure # Prompt used by .zshrc

# --- Terminal ---

tmux
tmuxinator

# --- Editors ---

vim
neovim

# --- Search & Navigation ---

fzf
ripgrep # rg - fast grep
bat # Better cat with syntax highlighting
ranger
universal-ctags # For vim tags

# --- Git ---

git
lazygit # TUI for git

# --- Development ---

node
python@3.9
awscli
k9s
kubernetes-cli
snowflake-cli

# --- Utilities ---

dust # Better du (disk usage)
htop # Process viewer
gnu-sed # GNU sed for consistency
grep # GNU grep
eza # Better ls (replaces exa)
fd # Better find
watch # For periodic commands
jq # JSON processor

# --- Apps (casks - install with: brew install --cask <name>) ---

# bettertouchtool # Install as cask

